{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "krupp://quant-analysis-report.schema.json",
  "title": "Krupp Capital Quant Analysis Report",
  "description": "Multi-dataset table export blueprint for the quant finance dashboard",
  "type": "object",
  "required": ["name", "version", "tables", "output"],
  "properties": {
    "name": { "type": "string", "const": "quant-analysis-report" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "output": {
      "type": "object",
      "required": ["formats", "default_format"],
      "properties": {
        "formats": { "type": "array", "items": { "enum": ["csv", "excel", "html"] } },
        "default_format": { "enum": ["csv", "excel", "html"] },
        "filename_prefix": { "type": "string" }
      }
    },
    "tables": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/table" }
    }
  },
  "definitions": {
    "table": {
      "type": "object",
      "required": ["title", "columns"],
      "properties": {
        "title": { "type": "string" },
        "source": { "type": "string" },
        "description": { "type": "string" },
        "columns": {
          "type": "array",
          "items": { "$ref": "#/definitions/column" }
        }
      }
    },
    "column": {
      "type": "object",
      "required": ["name", "type", "header"],
      "properties": {
        "name": { "type": "string" },
        "type": { "enum": ["datetime", "string", "integer", "float", "boolean"] },
        "format": { "type": "string" },
        "header": { "type": "string" },
        "source": { "type": "string" },
        "formula": { "type": "string" },
        "nullable": { "type": "boolean" },
        "range": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
      }
    }
  }
}
