// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// KRUPP CAPITAL // RISK DESK — persisted risk events (regime shifts, interceptor trips, auth lifecycle, crash injections)
model RiskEvent {
  id        String   @id @default(cuid())
  type      String
  severity  String   @default("info")
  source    String   @default("system")
  message   String
  payload   String?
  // optional dedupe floor: when set, POSTs carrying the same key within the
  // caller's window are swallowed server-side (multi-client desks — several
  // browser tabs stream the same feed and would otherwise double-log trips)
  dedupeKey String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type])
  @@index([dedupeKey, createdAt])
}

// KRUPP CAPITAL // VOLATILITY SNAPSHOTS — persisted CBOE complex + IV surface
// + composite risk captures (client 60s cadence, server-throttled). Powers the
// cross-boot "PERSISTED VOL STRIP" and post-mortem regime/contango reviews.
model VolSnapshot {
  id         String   @id @default(cuid())
  vix        Float
  vix9d      Float
  vix3m      Float
  skew       Float
  vvix       Float
  contango   Float // (VIX3M−VIX)/VIX × 100
  multiplier Float // piecewise VIX→multiplier anchor
  pcRatio    Float
  atmIV      Float
  flipStrike Float
  totalGex   Float
  spot       Float // underlying index level at capture
  score      Float // composite risk score
  regime     String // CALM | HIGH | CRISIS
  source     String // CBOE-LIVE | KRUPP-PARITY
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// KRUPP CAPITAL // SESSION JOURNAL — trader notes pinned to desk context
// (active tab, regime, composite score at write time). The desk-side logbook:
// observations survive reloads, feed the post-mortem workflow and are export-
// able alongside the execution ledger.
model JournalEntry {
  id        String   @id @default(cuid())
  clientId  String   // desk identity (persisted 'krupp-client-id', one per browser profile)
  desk      Int      @default(0) // tab index at write time (0 = LONDON EDGE landing)
  deskLabel String   @default("") // snapshot of the tab label (survives TABS re-ordering)
  regime    String   @default("") // CALM | HIGH | CRISIS at write time
  score     Float    @default(0) // composite risk score at write time
  text      String // note body (1..400 chars, validated server-side)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([clientId])
}

// KRUPP CAPITAL // EXECUTION LEDGER — persisted paper fills (futures + options context tickets)
// Blotter survives reloads; session aggregates (realized/fees/volume/blocks) rebuilt from this stream.
model LedgerFill {
  id        String   @id @default(cuid())
  clientId  String   @unique // client-generated fill id (dedupe across reloads)
  kind      String   @default("FUT") // FUT | OPT
  sym       String
  side      String
  qty       Int
  px        Float
  slipTicks Int      @default(0)
  status    String // FILLED | BLOCKED | FLATTEN | OPT_BUY | OPT_SELL | OPT_CLOSE
  reason    String?
  pnl       Float?
  meta      String?  // JSON: strike/callIV/expiry for options, position snapshot for futures
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([kind])
}
